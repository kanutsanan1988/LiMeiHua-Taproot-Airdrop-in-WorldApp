{
  "name": "limeihua-taproot-airdrop-worldapp",
  "version": "1.0.0",
  "description": "Taproot Assets Airdrop System integrated with WorldApp and World ID verification",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "echo 'Backend ready'",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "taproot",
    "assets",
    "airdrop",
    "worldapp",
    "world-id",
    "lightning",
    "bitcoin",
    "blockchain"
  ],
  "author": "Mr. Kanutsanan Pongpanna",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "mongoose": "^7.3.1",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "uuid": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4"
  },
